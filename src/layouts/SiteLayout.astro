
---
import "../styles/home.css";
import { getLocale, getUiText } from '../i18n/ui';
import "katex/dist/katex.min.css";

const locale = getLocale(Astro.url.pathname);
const t = getUiText(locale);

const {
    title = "Antemundane sprǣc — Explore Ideas",
    description = "An open forum for free discussion and exploration of physics, mathematics, and philosophy."
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
    <head>
        <script is:inline>
            const savedTheme = localStorage.getItem("theme");

            if (savedTheme === "light") {
                document.documentElement.classList.add("light-theme");
            }
        </script>

        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />

        <title>{title}</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>

    <body>
        <header class="topbar">

            <div class="logo animated-title" aria-label="Antemundane sprǣc" translate="no">
                <img class="site-logo logo-day" src="/images/Daymodelogo.jpg" alt="" />
                <img class="site-logo logo-night" src="/images/Nightmodelogo.jpg" alt="" />
                
                <span>Ant</span>

                <button
                    class="letter-trigger"
                    type="button"
                    aria-label="Transform e into i using complex logarithms"
                    aria-pressed="false"
                >
                    <span class="letter-e">e</span>
                    <span class="letter-i">i</span>
                </button>

                <span>mundane</span>
                <span class="title-ending"> sprǣc</span>

                <span class="formula-overlay" aria-hidden="true">
                    <span class="formula-forward">
                        <span class="formula-fraction">
                            <span class="formula-numerator">ln(−1)</span>
                            <span class="fraction-bar"></span>
                            <span class="formula-denominator">π</span>
                        </span>
                        <span class="formula-equals">= i</span>
                    </span>

                    <span class="formula-reverse">e<sup>iπ</sup> = −1</span>
                </span>
            </div>

            <nav class="main-navigation" aria-label="Main navigation">
                <a href="/">{t.home}</a>

                <div class="nav-dropdown">
                    <a href="/physics/" class="nav-trigger">{t.physics}</a>
                    <div class="dropdown-menu">
                        <a href="/physics/">{t.physicsOverview}</a>
                        <a href="/physics/forum/">{t.physicsForum}</a>
                        <a href="/physics/interesting-topics/">{t.physicsTopics}</a>
                        <a href="/physics/experiments/">{t.physicsSimulations}</a>
                        <a href="/physics/games/">{t.physicsGames}</a>
                    </div>
                </div>

                <div class="nav-dropdown">
                    <a href="/mathematics/" class="nav-trigger">{t.mathematics}</a>
                    <div class="dropdown-menu">
                        <a href="/mathematics/">{t.mathematicsOverview}</a>
                        <a href="/mathematics/forum/">{t.mathematicsForum}</a>
                        <a href="/mathematics/interesting-topics/">{t.mathematicsTopics}</a>
                        <a href="/mathematics/games/">{t.mathematicsGames}</a>
                    </div>
                </div>

                <div class="nav-dropdown">
                    <a href="/philosophy/" class="nav-trigger">{t.philosophy}</a>
                    <div class="dropdown-menu">
                        <a href="/philosophy/">{t.philosophyOverview}</a>
                        <a href="/philosophy/forum/">{t.philosophyForum}</a>
                        <a href="/philosophy/epistemology/">{t.epistemology}</a>
                        <a href="/philosophy/religion/">{t.religion}</a>
                        <a href="/philosophy/games/">{t.philosophyGames}</a>
                    </div>
                </div>

                <a href="/journal/" class="nav-trigger">{t.journal}</a>

                <a href="/settings/" class="settings-link" aria-label="Settings">
                  <span aria-hidden="true">⚙</span>
                  <span>{t.settings}</span>
                </a>
            </nav>
        </header>

        <main>
            <slot />
        </main>

        <footer>
            <p>{t.footer}</p>
        </footer>

        <script src="../scripts/title-animation.js"></script>
    </body>
</html>
