
---
import SiteLayout from "../../layouts/SiteLayout.astro";

const introduction =
    "这是一个开放的交流空间，供人们自由讨论与探索物理学、数学和哲学。我们关注的内容包括：词源、推导、实验、思想碰撞……";
---

<SiteLayout
    title="Antemundane sprǣc — 探索思想"
    description={introduction}
>
    <section class="hero">
        <p class="eyebrow">一个充满好奇心的空间</p>
        <h1>关于知识，但不止于知识。</h1>
        <p class="intro">{introduction}</p>
        <a class="explore" href="#explore">按兴趣探索 ↓</a>
    </section>

    <section id="explore" class="topics">
        <p class="eyebrow">探索</p>
        <h2>三条探索之路</h2>

        <div class="topic-grid">
            <a id="physics" class="topic" href="/zh-cn/physics/">
                <div class="topic-figure">
                    <img
                        src="/images/physicscover.jpg"
                        alt="光线通过棱镜发生色散。"
                    />

                    <div class="topic-copy">
                        <span class="number">01 / 宇宙</span>
                        <h3>物理学</h3>
                        <p>从自由落体的运动，到时空的深层结构。</p>
                    </div>
                </div>
            </a>

            <a id="mathematics" class="topic" href="/zh-cn/mathematics/">
                <div class="topic-figure">
                    <img
                        src="/images/mathcover.jpg"
                        alt="数学方程与数学表达式。"
                    />

                    <div class="topic-copy">
                        <span class="number">02 / 模式与证明</span>
                        <h3>数学</h3>
                        <p>探索优雅的方程、严谨的证明，以及意想不到的联系。</p>
                    </div>
                </div>
            </a>

            <a id="philosophy" class="topic" href="/zh-cn/philosophy/">
                <div class="topic-figure">
                    <img
                        src="/images/philosophycover.jpg"
                        alt="拉斐尔创作的《雅典学院》。"
                    />

                    <div class="topic-copy">
                        <span class="number">03 / 思想与知识</span>
                        <h3>哲学</h3>
                        <p>追问我们知道什么、如何知道，以及现实究竟是什么。</p>
                    </div>
                </div>
            </a>
        </div>
    </section>

    <section id="journal" class="journal">
        <p class="eyebrow">思想日志</p>
        <h2>思想、问题与发现</h2>

        <p class="journal-intro">
            一系列跨越物理学、数学与哲学领域的探索与思考。
        </p>

        <div class="journal-list">

            <article class="journal-entry featured-entry">
                <span class="number">01 / 精选</span>
                <h3>对现实的近似</h3>
                <p>探索那些挑战并重塑我们直觉的事物。</p>
                <a href="#">阅读文章 ↗</a>
            </article>

            <article class="journal-entry">
                <span class="number">02 / 数学</span>
                <h3>自然的语言</h3>
                <a href="#">阅读文章 ↗</a>
            </article>

            <article class="journal-entry">
                <span class="number">03 / 哲学</span>
                <h3>思想的碰撞</h3>
                <a href="#">阅读文章 ↗</a>
            </article>

        </div>
    </section>

    <section class="note">
        <p class="eyebrow">一点个人感想</p>
        <h2>不只是寻找答案，更要提出更好的问题。</h2>
        <p>
            这是一个不断生长的思想集合，记录着各种观点、解释、
            思想实验与发现。有些想法源自已经确立的科学理论；
            另一些则是值得继续探索的问题。
        </p>
    </section>
</SiteLayout>
