
---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Translation Test">
    <main class="translation-test">
        <h1>Translation Experiment</h1>

        <p>
            Welcome to Antemundane sprǣc. This is a temporary
            page for testing English and Chinese translation.
        </p>

        <p>
            Physics explores the fundamental laws governing
            matter, energy, space, and time.
        </p>

        <p>
            Mathematics provides a rigorous language for
            describing patterns and relationships.
        </p>

        <h2>Mathematical notation</h2>

        <p>
            The famous Euler identity is:
            <span translate="no">e^(iπ) + 1 = 0</span>
        </p>

        <h2>Code example</h2>

        <pre translate="no"><code>const velocity = distance / time;</code></pre>

        <div class="translation-widget">
            <h2>Choose your language</h2>
            <div class="gtranslate_wrapper"></div>
        </div>
    </main>
</SiteLayout>

<script is:inline>
    window.gtranslateSettings = {
        "default_language": "en",
        "native_language_names": true,
        "languages": ["en", "zh-CN"],
        "wrapper_selector": ".gtranslate_wrapper"
    };
</script>

<script
    is:inline
    src="https://cdn.gtranslate.net/widgets/latest/dropdown.js"
    defer
></script>
