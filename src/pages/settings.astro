---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Settings">
    <main class="settings-page">
      <header class="settings-header">      
        <h1>Settings</h1>
        <p>Customize your experience on Antemundane sprǣc.</p>
      </header>

        <section class="settings-card language-settings">
          <div class="settings-description">
            <h2>Language</h2>
            <p>Choose your preferred language for the website.</p>
          </div>

          <div class="gtranslate_wrapper"></div>
        </section>

        <section class="settings-card theme-settings">
          <div class="settings-description">
            <h2>Appearance</h2>
            <p>Choose the preferred theme for the website.</p>
          </div>

          <button id="theme-toggle" class="theme-toggle" type="button">
            Light mode
          </button>
        </section>
    </main>
</SiteLayout>