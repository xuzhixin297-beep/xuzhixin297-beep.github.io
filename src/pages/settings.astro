---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Settings">
    <main class="settings-page">
      <header class="settings-header">      
        <h1>Settings</h1>
        <p>Customize your experience on Antemundane sprǣc.</p>
      </header>

        
       <section class="settings-card language-settings">
          <div class="settings-description">
            <h2>Language</h2>
            <p>Choose your preferred language for the website.</p>
          </div>

          <div class="language-options">
           <label for="site-language">Website language</label>

           <select id="site-language">
             <option value="en">English</option>
             <option value="zh-cn">简体中文</option>
           </select>
          </div>
       </section>


        <section class="settings-card theme-settings">
          <div class="settings-description">
            <h2>Appearance</h2>
            <p>Choose the preferred theme for the website.</p>
          </div>

          <div class="theme-options">
            <button
               class="theme-option light-option"
               data-theme="light"
               type="button"
               aria-pressed="false"
            >
              <span class="theme-preview light-preview">
               <span class="theme-icon" aria-hidden="true">☀</span>
              </span>
              <span class="theme-option-label">Light</span>
            </button>

            <button
              class="theme-option dark-option"
              data-theme="dark"
              type="button"
              aria-pressed="false"
            >
              <span class="theme-preview dark-preview">
               <span class="theme-icon" aria-hidden="true">☾</span>
              </span>
              <span class="theme-option-label">Dark</span>
            </button>
         </div>
        </section>
    </main>
</SiteLayout>

<script is:inline>
  const languageSelect = document.getElementById("site-language");

  if (languageSelect) {
    const currentPath = window.location.pathname;
    const isChinese = currentPath.startsWith("/zh-cn/") ||
                     currentPath === "/zh-cn";

    languageSelect.value = isChinese ? "zh-cn" : "en";

    languageSelect.addEventListener("change", () => {
      const path = window.location.pathname;
      const selectedLanguage = languageSelect.value;

      if (selectedLanguage === "zh-cn") {
        if (path === "/zh-cn" || path.startsWith("/zh-cn/")) {
          return;
        }

        window.location.href = "/zh-cn" + path;
      } else {
        if (path === "/zh-cn") {
          window.location.href = "/";
        } else if (path.startsWith("/zh-cn/")) {
          window.location.href = path.substring(6);
        }
      }
    });
  }
</script>