---
import SiteLayout from "../../layouts/SiteLayout.astro";
import "../../styles/journal.css";
---

<SiteLayout
    title="Journal — Antemundane sprǣc"
    description="A collection of essays, questions, and reflections."
>
    <!-- Journal introduction -->
    <section class="journal-hero">
        <p class="eyebrow">THE JOURNAL</p>

        <h1>Thoughts along the way.</h1>

        <p class="journal-introduction">
            A space for ideas, questions, explorations,
            and thoughts that wander beyond the familiar.
        </p>
    </section>

    <!-- Search and filters -->
    <section class="journal-discovery">
      <div class="journal-search">
        <svg
            class="journal-search-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
        >
            <circle cx="10.8" cy="10.8" r="6.8" />
            <path d="m16 16 4 4" />
        </svg>

        <input
          type="search"
          id="journal-search"
          placeholder="Search articles, ideas, or tags..."
          aria-label="Search journal articles"
        />

        <div class="selected-filters" id="selected-filters"></div>
      </div>

      <div class="journal-tags" aria-label="Filter articles by topic">
        <button class="journal-tag active" type="button" data-filter="All">All</button>
        <button class="journal-tag" type="button" data-filter="Physics">Physics</button>
        <button class="journal-tag" type="button" data-filter="Mathematics">Mathematics</button>
        <button class="journal-tag" type="button" data-filter="Philosophy">Philosophy</button>
        <button class="journal-tag" type="button" data-filter="Reflections">Reflections</button>
      </div>
    </section>

    <!-- Article collection -->
    <section class="journal-library">

        <div class="journal-library-heading">
            <p class="eyebrow">THE COLLECTION</p>
            <h2>Explore writings</h2>
        </div>

        <!-- Articles will be rendered here in the future -->
        <div class="journal-article-list" id="journal-article-list">

            <div class="journal-empty-state">
                <div class="journal-empty-symbol" aria-hidden="true">
                    ✳
                </div>

                <h3>The pages are still unwritten.</h3>

                <p>
                    There are no articles here yet.
                    Every collection begins with a first thought.
                </p>
            </div>

        </div>

    </section>

    <!-- Pagination -->
    <nav class="journal-pagination" aria-label="Journal pages">

        <button type="button" disabled>
            ← Previous
        </button>

        <div class="journal-page-numbers">
            <button type="button" class="current-page" aria-current="page">
                1
            </button>
        </div>

        <button type="button" disabled>
            Next →
        </button>

    </nav>

</SiteLayout>

<script>
    const filterButtons = document.querySelectorAll(".journal-tag");
    const selectedFiltersContainer = document.querySelector("#selected-filters");
    if (!selectedFiltersContainer) {
      throw new Error("Selected filters container was not found.");
    }

    const selectedFilters = new Set();

    // Update the appearance of buttons and selected-filter chips
    function updateFilters() {
        // Update button active states
        filterButtons.forEach((button) => {
            const filterName = button.dataset.filter;

            const isActive =
                filterName === "All"
                    ? selectedFilters.size === 0
                    : selectedFilters.has(filterName);

            button.classList.toggle("active", isActive);
        });

        // Remove old chips before rebuilding them
        selectedFiltersContainer.replaceChildren();

        // Create a chip for every selected topic
        selectedFilters.forEach((filterName) => {
            const chip = document.createElement("div");
            chip.className = "filter-chip";

            const label = document.createElement("span");
            label.textContent = filterName;

            const removeButton = document.createElement("button");
            removeButton.className = "filter-chip-remove";
            removeButton.type = "button";
            removeButton.textContent = "×";
            removeButton.setAttribute(
                "aria-label",
                `Remove ${filterName} filter`
            );

            // Remove this individual filter
            removeButton.addEventListener("click", () => {
                selectedFilters.delete(filterName);
                updateFilters();
            });

            chip.append(label, removeButton);
            selectedFiltersContainer.appendChild(chip);
        });
    }

    // Handle clicks on the topic buttons
    filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const filterName = button.dataset.filter;

            if (filterName === "All") {
                // Clear every selected filter
                selectedFilters.clear();
            } else if (selectedFilters.has(filterName)) {
                // Clicking an active topic deselects it
                selectedFilters.delete(filterName);
            } else {
                // Clicking an inactive topic adds it
                selectedFilters.add(filterName);
            }

            updateFilters();
        });
    });
</script>